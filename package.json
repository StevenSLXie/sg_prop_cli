{
  "name": "sg-housing-data",
  "version": "0.1.6",
  "description": "Local CLI and MCP server for Singapore housing/property public data.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "sg-housing": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "research",
    "evals",
    "examples/*.png",
    "scripts",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "eval:skills": "node scripts/eval-skills.mjs",
    "start:mcp": "node dist/cli.js mcp",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "commander": "^14.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
